[study]
default_export_root = "exports/study"
default_study_group = "main"
allowed_tags = [
  "baseline",
  "session_start",
  "session_end",
  "reached_level_5",
  "reached_level_10",
  "reached_level_20",
  "class_advance",
  "quest_milestone",
  "boss_unlock",
]
allowed_milestone_tags = [
  "reached_level_5",
  "reached_level_10",
  "reached_level_20",
  "class_advance",
  "quest_milestone",
  "boss_unlock",
]
allowed_run_types = ["baseline", "checkpoint", "session_end", "milestone"]

[accounts.speed_run]
account_label = "speed_run"
strategy_label = "speed"
export_subdir = "speed_run"

[accounts.skill_focus]
account_label = "skill_focus"
strategy_label = "skills"
export_subdir = "skill_focus"

[accounts.balanced_run]
account_label = "balanced_run"
strategy_label = "balanced"
export_subdir = "balanced_run"
